@startuml 06-navegacion
title Diagrama de navegación — Vinilos Mobile (Sprint 2)
skinparam shadowing false
skinparam defaultFontName Helvetica
skinparam defaultFontSize 11
skinparam activityBackgroundColor #EDF2F7
skinparam activityBorderColor #4A5568

start
:Inicio de la app;
if (¿Hay rol guardado en DataStore?) then (sí)
else (no)
  :EntryActivity;
  :Elegir Visitante o Coleccionista;
  :Guardar rol en DataStore;
endif
:MainActivity\n(ViewPager2 + menú inferior);
fork
  :AlbumCatalogFragment;
  if (¿Toca Nuevo álbum?\n(solo Coleccionista)) then (sí)
    :CreateAlbumActivity\nentra desde abajo;
    if (¿Guarda un álbum válido?) then (sí)
      :Vuelve al catálogo con el álbum\nde primero y un snackbar;
    else (cancela)
      :Vuelve al catálogo sin cambios;
    endif
  else (no)
    :AlbumDetailActivity\nrecibe el id del álbum;
  endif
fork again
  :ArtistsFragment;
  :ArtistDetailActivity\nrecibe ArtistKey;
fork again
  :CollectorsFragment\n(marcador: HU05 y HU06 son del Sprint 2);
end fork
:Volver con el botón Atrás o la app bar;
stop

note right
  El FAB Nuevo álbum solo se muestra en la
  pestaña Álbumes y el de track en el detalle;
  ambos solo con rol Coleccionista.
end note

@enduml
