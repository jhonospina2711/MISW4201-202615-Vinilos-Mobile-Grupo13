<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">
    <com.example.vinilosmobile.coreui.molecules.DetailToolbarView
        android:id="@+id/detailToolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        app:title="@string/collector_detail_title" />
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">
        <ScrollView
            android:id="@+id/detailContent"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true"
            android:visibility="gone">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="@dimen/vinilos_space_md"
                android:paddingTop="@dimen/vinilos_space_sm"
                android:paddingEnd="@dimen/vinilos_space_md"
                android:paddingBottom="@dimen/vinilos_space_lg">
                <com.example.vinilosmobile.coreui.atoms.ArtistAvatarView
                    android:id="@+id/collectorAvatar"
                    android:layout_width="128dp"
                    android:layout_height="128dp"
                    android:layout_gravity="center_horizontal" />
                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/collectorName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/vinilos_space_md"
                    android:gravity="center"
                    android:textAppearance="?attr/textAppearanceHeadlineSmall"
                    tools:text="Manolo Bellon" />
                <com.google.android.material.textview.MaterialTextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/vinilos_space_lg"
                    android:text="@string/collector_phone"
                    android:textAppearance="?attr/textAppearanceLabelSmall"
                    android:textColor="?attr/colorOnSurfaceVariant" />
                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/collectorPhone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textAppearance="?attr/textAppearanceBodyMedium"
                    tools:text="350 245 7896" />
                <com.google.android.material.textview.MaterialTextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/vinilos_space_sm"
                    android:text="@string/collector_email"
                    android:textAppearance="?attr/textAppearanceLabelSmall"
                    android:textColor="?attr/colorOnSurfaceVariant" />
                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/collectorEmail"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textAppearance="?attr/textAppearanceBodyMedium"
                    tools:text="manolo@caracol.com.co" />

                <com.example.vinilosmobile.coreui.molecules.SectionHeaderView
                    android:id="@+id/favoritesHeader"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/vinilos_space_lg" />
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/favoritesList"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:nestedScrollingEnabled="false"
                    tools:listitem="@layout/vinilos_item_artist" />
                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/favoritesEmpty"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/collector_no_favorites"
                    android:textAppearance="?attr/textAppearanceBodyMedium"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    android:visibility="gone" />

                <com.example.vinilosmobile.coreui.molecules.SectionHeaderView
                    android:id="@+id/collectionHeader"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/vinilos_space_lg" />
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/collectionList"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:nestedScrollingEnabled="false"
                    tools:listitem="@layout/vinilos_item_album" />
                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/collectionEmpty"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/collector_no_albums"
                    android:textAppearance="?attr/textAppearanceBodyMedium"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    android:visibility="gone" />

                <com.example.vinilosmobile.coreui.molecules.SectionHeaderView
                    android:id="@+id/commentsHeader"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/vinilos_space_lg" />
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/commentList"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:nestedScrollingEnabled="false"
                    tools:listitem="@layout/vinilos_item_detail_row" />
                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/commentsEmpty"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/collector_no_comments"
                    android:textAppearance="?attr/textAppearanceBodyMedium"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    android:visibility="gone" />
            </LinearLayout>
        </ScrollView>
        <com.google.android.material.progressindicator.CircularProgressIndicator
            android:id="@+id/detailLoading"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:contentDescription="@string/collector_detail_loading" />
        <com.example.vinilosmobile.coreui.organisms.ContentStateView
            android:id="@+id/detailMessage"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:padding="@dimen/vinilos_space_lg"
            android:visibility="gone" />
    </FrameLayout>
</LinearLayout>
