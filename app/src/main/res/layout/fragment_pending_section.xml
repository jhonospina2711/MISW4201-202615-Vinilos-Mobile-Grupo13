<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/vinilos_background"
    android:orientation="vertical"
    android:paddingStart="@dimen/vinilos_space_md"
    android:paddingTop="@dimen/vinilos_space_lg"
    android:paddingEnd="@dimen/vinilos_space_md">
    <com.google.android.material.textview.MaterialTextView
        android:id="@+id/sectionTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textAppearance="?attr/textAppearanceHeadlineMedium"
        tools:text="Artistas" />
    <com.google.android.material.textview.MaterialTextView
        android:id="@+id/sectionMessage"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/vinilos_space_md"
        android:textAppearance="?attr/textAppearanceBodyMedium"
        android:textColor="?attr/colorOnSurfaceVariant"
        tools:text="Aquí aparecerá el listado de músicos y bandas." />
</LinearLayout>
