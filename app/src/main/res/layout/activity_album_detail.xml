<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/vinilos_background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">
        <com.example.vinilosmobile.coreui.molecules.DetailToolbarView
            android:id="@+id/detailToolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            app:title="@string/album_detail_title" />

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">
            <ScrollView
                android:id="@+id/detailContent"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:fillViewport="true"
                android:visibility="gone">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingStart="@dimen/vinilos_space_lg"
                    android:paddingTop="@dimen/vinilos_space_sm"
                    android:paddingEnd="@dimen/vinilos_space_lg"
                    android:paddingBottom="80dp">
                    <com.example.vinilosmobile.coreui.atoms.SquareAlbumCover
                        android:layout_width="208dp"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_horizontal"
                        app:cardBackgroundColor="@color/vinilos_cover_one"
                        app:cardCornerRadius="@dimen/vinilos_radius_card"
                        app:cardElevation="0dp">
                        <ImageView
                            android:id="@+id/detailCover"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:scaleType="centerInside"
                            android:src="@drawable/ic_album_placeholder" />
                    </com.example.vinilosmobile.coreui.atoms.SquareAlbumCover>

                    <com.google.android.material.textview.MaterialTextView
                        android:id="@+id/detailName"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/vinilos_space_md"
                        android:gravity="center"
                        android:textAppearance="?attr/textAppearanceHeadlineSmall"
                        tools:text="Buscando América" />
                    <com.google.android.material.textview.MaterialTextView
                        android:id="@+id/detailArtist"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/vinilos_space_xs"
                        android:gravity="center"
                        android:textAppearance="?attr/textAppearanceBodyMedium"
                        android:textColor="@color/vinilos_on_surface_variant"
                        tools:text="Rubén Blades Bellido de Luna" />
                    <com.google.android.material.chip.ChipGroup
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_horizontal"
                        android:layout_marginTop="@dimen/vinilos_space_sm"
                        app:chipSpacingHorizontal="@dimen/vinilos_space_xs">
                        <com.google.android.material.chip.Chip
                            android:id="@+id/genreChip"
                            style="@style/Widget.Material3.Chip.Assist"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:clickable="false"
                            tools:text="Salsa" />
                        <com.google.android.material.chip.Chip
                            android:id="@+id/labelChip"
                            style="@style/Widget.Material3.Chip.Assist"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:clickable="false"
                            tools:text="Elektra" />
                    </com.google.android.material.chip.ChipGroup>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/vinilos_space_md"
                        android:orientation="horizontal">
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">
                            <com.google.android.material.textview.MaterialTextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="@string/album_release_date"
                                android:textAppearance="?attr/textAppearanceLabelSmall"
                                android:textColor="@color/vinilos_on_surface_variant" />
                            <com.google.android.material.textview.MaterialTextView
                                android:id="@+id/detailDate"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:textAppearance="?attr/textAppearanceBodyMedium"
                                tools:text="1 de agosto de 1984" />
                        </LinearLayout>
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">
                            <com.google.android.material.textview.MaterialTextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="@string/album_record_label"
                                android:textAppearance="?attr/textAppearanceLabelSmall"
                                android:textColor="@color/vinilos_on_surface_variant" />
                            <com.google.android.material.textview.MaterialTextView
                                android:id="@+id/detailLabel"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:textAppearance="?attr/textAppearanceBodyMedium"
                                tools:text="Elektra" />
                        </LinearLayout>
                    </LinearLayout>

                    <com.google.android.material.textview.MaterialTextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/vinilos_space_md"
                        android:text="@string/album_detail_description"
                        android:textAppearance="?attr/textAppearanceLabelSmall"
                        android:textColor="@color/vinilos_on_surface_variant" />
                    <com.google.android.material.textview.MaterialTextView
                        android:id="@+id/detailDescription"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textAppearance="?attr/textAppearanceBodyMedium"
                        tools:text="Descripción del álbum" />

                    <com.example.vinilosmobile.coreui.molecules.SectionHeaderView
                        android:id="@+id/tracksHeader"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/vinilos_space_lg" />
                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/trackList"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:nestedScrollingEnabled="false"
                        tools:listitem="@layout/vinilos_item_detail_row" />
                    <com.google.android.material.textview.MaterialTextView
                        android:id="@+id/tracksEmpty"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/vinilos_space_sm"
                        android:textAppearance="?attr/textAppearanceBodyMedium"
                        android:textColor="@color/vinilos_on_surface_variant"
                        android:visibility="gone" />

                    <com.example.vinilosmobile.coreui.molecules.SectionHeaderView
                        android:id="@+id/commentsHeader"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/vinilos_space_lg" />
                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/commentList"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:nestedScrollingEnabled="false"
                        tools:listitem="@layout/vinilos_item_detail_row" />
                    <com.google.android.material.textview.MaterialTextView
                        android:id="@+id/commentsEmpty"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/vinilos_space_sm"
                        android:textAppearance="?attr/textAppearanceBodyMedium"
                        android:textColor="@color/vinilos_on_surface_variant"
                        android:visibility="gone" />
                </LinearLayout>
            </ScrollView>

            <com.google.android.material.progressindicator.CircularProgressIndicator
                android:id="@+id/detailLoading"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center" />
            <com.example.vinilosmobile.coreui.organisms.ContentStateView
                android:id="@+id/detailMessage"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:padding="@dimen/vinilos_space_lg"
                android:visibility="gone" />
        </FrameLayout>
    </LinearLayout>

    <com.google.android.material.floatingactionbutton.ExtendedFloatingActionButton
        android:id="@+id/addTrackFab"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_margin="@dimen/vinilos_space_md"
        android:text="@string/add_track"
        android:visibility="gone"
        app:icon="@drawable/ic_add" />
</FrameLayout>
