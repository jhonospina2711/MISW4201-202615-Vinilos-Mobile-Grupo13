<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground"
    android:orientation="vertical"
    android:paddingStart="@dimen/vinilos_space_xs"
    android:paddingTop="@dimen/vinilos_space_xs"
    android:paddingEnd="@dimen/vinilos_space_xs"
    android:paddingBottom="@dimen/vinilos_space_sm">

    <com.example.vinilosmobile.coreui.atoms.SquareAlbumCover
        android:id="@+id/albumCoverCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardBackgroundColor="@color/vinilos_cover_one"
        app:cardCornerRadius="@dimen/vinilos_radius_card"
        app:cardElevation="0dp">

        <ImageView
            android:id="@+id/albumCover"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:importantForAccessibility="no"
            android:scaleType="centerInside"
            android:src="@drawable/ic_album_placeholder" />
    </com.example.vinilosmobile.coreui.atoms.SquareAlbumCover>

    <com.google.android.material.textview.MaterialTextView
        android:id="@+id/albumTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/vinilos_space_sm"
        android:ellipsize="end"
        android:maxLines="2"
        android:textAppearance="?attr/textAppearanceTitleSmall"
        tools:text="Buscando América" />

    <com.google.android.material.textview.MaterialTextView
        android:id="@+id/albumArtist"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="1"
        android:textAppearance="?attr/textAppearanceBodySmall"
        android:textColor="?attr/colorOnSurfaceVariant"
        tools:text="Rubén Blades" />

    <com.google.android.material.textview.MaterialTextView
        android:id="@+id/albumMetadata"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="1"
        android:textAppearance="?attr/textAppearanceLabelSmall"
        android:textColor="?attr/colorOnSurfaceVariant"
        tools:text="Salsa · 1984" />
</LinearLayout>
