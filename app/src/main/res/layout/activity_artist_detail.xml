<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/vinilos_background"
    android:orientation="vertical">
    <com.example.vinilosmobile.coreui.molecules.DetailToolbarView
        android:id="@+id/detailToolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        app:title="@string/artist_detail_title" />
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">
        <ScrollView
            android:id="@+id/detailContent"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true"
            android:visibility="gone">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="@dimen/vinilos_space_md"
                android:paddingTop="@dimen/vinilos_space_sm"
                android:paddingEnd="@dimen/vinilos_space_md"
                android:paddingBottom="@dimen/vinilos_space_lg">
                <com.example.vinilosmobile.coreui.atoms.ArtistAvatarView
                    android:id="@+id/artistAvatar"
                    android:layout_width="120dp"
                    android:layout_height="120dp"
                    android:layout_gravity="center_horizontal" />
                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/artistName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/vinilos_space_md"
                    android:gravity="center"
                    android:textAppearance="?attr/textAppearanceHeadlineSmall"
                    tools:text="Rubén Blades Bellido de Luna" />
                <com.google.android.material.chip.Chip
                    android:id="@+id/artistTypeChip"
                    style="@style/Widget.Material3.Chip.Assist"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="@dimen/vinilos_space_sm"
                    android:clickable="false"
                    tools:text="Músico" />
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/vinilos_space_md"
                    android:orientation="horizontal">
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">
                        <com.google.android.material.textview.MaterialTextView
                            android:id="@+id/artistDateLabel"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textAppearance="?attr/textAppearanceLabelSmall"
                            android:textColor="@color/vinilos_on_surface_variant" />
                        <com.google.android.material.textview.MaterialTextView
                            android:id="@+id/artistDate"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textAppearance="?attr/textAppearanceBodyMedium"
                            tools:text="16 de julio de 1948" />
                    </LinearLayout>
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">
                        <com.google.android.material.textview.MaterialTextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/nav_albums"
                            android:textAppearance="?attr/textAppearanceLabelSmall"
                            android:textColor="@color/vinilos_on_surface_variant" />
                        <com.google.android.material.textview.MaterialTextView
                            android:id="@+id/artistAlbumCount"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textAppearance="?attr/textAppearanceBodyMedium"
                            tools:text="2" />
                    </LinearLayout>
                </LinearLayout>
                <com.google.android.material.textview.MaterialTextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/vinilos_space_md"
                    android:text="@string/album_detail_description"
                    android:textAppearance="?attr/textAppearanceLabelSmall"
                    android:textColor="@color/vinilos_on_surface_variant" />
                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/artistDescription"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textAppearance="?attr/textAppearanceBodyMedium"
                    tools:text="Cantante, compositor y músico." />

                <com.example.vinilosmobile.coreui.molecules.SectionHeaderView
                    android:id="@+id/albumsHeader"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/vinilos_space_lg" />
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/artistAlbumList"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:nestedScrollingEnabled="false"
                    tools:listitem="@layout/vinilos_item_album" />
                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/albumsEmpty"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/artist_no_albums"
                    android:textAppearance="?attr/textAppearanceBodyMedium"
                    android:textColor="@color/vinilos_on_surface_variant"
                    android:visibility="gone" />

                <com.example.vinilosmobile.coreui.molecules.SectionHeaderView
                    android:id="@+id/awardsHeader"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/vinilos_space_lg" />
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/awardList"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:nestedScrollingEnabled="false"
                    tools:listitem="@layout/vinilos_item_detail_row" />
                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/awardsEmpty"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/artist_no_awards"
                    android:textAppearance="?attr/textAppearanceBodyMedium"
                    android:textColor="@color/vinilos_on_surface_variant"
                    android:visibility="gone" />

                <com.example.vinilosmobile.coreui.molecules.SectionHeaderView
                    android:id="@+id/membersHeader"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/vinilos_space_lg"
                    android:visibility="gone" />
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/memberList"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:nestedScrollingEnabled="false"
                    android:visibility="gone"
                    tools:listitem="@layout/vinilos_item_artist" />
                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/membersEmpty"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/artist_no_members"
                    android:textAppearance="?attr/textAppearanceBodyMedium"
                    android:textColor="@color/vinilos_on_surface_variant"
                    android:visibility="gone" />
            </LinearLayout>
        </ScrollView>
        <com.google.android.material.progressindicator.CircularProgressIndicator
            android:id="@+id/detailLoading"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center" />
        <com.example.vinilosmobile.coreui.organisms.ContentStateView
            android:id="@+id/detailMessage"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:padding="@dimen/vinilos_space_lg"
            android:visibility="gone" />
    </FrameLayout>
</LinearLayout>
